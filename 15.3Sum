class Solution:
    def threeSum(self, nums: list[int]) -> list[list[int]]:
        nums.sort()
        ans=[]
        for i in range(len(nums)):
            if i>0 and nums[i]==nums[i-1]:
                continue
            left=i+1
            right=len(nums)-1
            while left<right:
                t=nums[i]+nums[left]+nums[right]
                if t<0:
                    left+=1
                elif t>0:
                    right-=1
                else:
                    ch=[nums[i],nums[left],nums[right]]
                    ans.append(ch)
                    left+=1
                    right-=1
                    while left<right and nums[left]==nums[left-1]:
                        left+=1
        return ans
