class Solution:
    def fourSum(self, nums: List[int], target: int) -> List[List[int]]:
        nums.sort()
        l=[]
        for i in range(len(nums)):
            for j in range(i+1,len(nums)):
                k=j+1
                la=len(nums)-1
                while(k<la):
                    t=nums[i]+nums[j]+nums[k]+nums[la]
                    if(t<target):
                        k+=1
                    elif(t>target):
                        la-=1
                    else:
                        ch=[nums[i],nums[j],nums[k],nums[la]]
                        l.append(ch)
                        k+=1
                        la-=1
                        while k<la and nums[k]==nums[k-1]:
                            k+=1
        l2=[]
        for i in l:
            if(i not in l2):
                l2.append(i)
        return l2
